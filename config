# ---- Image basics ----
IMG_NAME="rpios-arm64"
RELEASE="trixie"
PI_GEN_RELEASE="Raspberry Pi reference"

# ---- Compression ----
DEPLOY_COMPRESSION="xz"
COMPRESSION_LEVEL="6"

# ---- Identity / login ----
TARGET_HOSTNAME="rpi"
FIRST_USER_NAME="pi"
FIRST_USER_PASS=""            # empty => account locked; set on first boot wizard
DISABLE_FIRST_BOOT_USER_RENAME="0"

# ---- Regional ----
LOCALE_DEFAULT="en_CA.UTF-8"
TIMEZONE_DEFAULT="America/Halifax"   # change to "UTC" if preferred
KEYBOARD_KEYMAP="ca"
KEYBOARD_LAYOUT="English (Canada)"

# ---- Connectivity ----
WPA_COUNTRY="CA"
ENABLE_SSH="1"
PUBKEY_ONLY_SSH="0"           # allow password after first-boot user creation
